# 1. Base Image: NVIDIA CUDA 12.8 on Ubuntu 24.04
FROM nvidia/cuda:12.8.0-cudnn-devel-ubuntu24.04

# Set environment variables
ENV LANG=en_US.UTF-8
ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=jazzy

# Set default RUN shell to bash
SHELL ["/bin/bash", "-c"]

########################################################
# 2. System Core & Python 3.12 Setup
########################################################
RUN apt-get update && apt-get install -y --no-install-recommends \
    git cmake build-essential curl wget gnupg2 lsb-release locales \
    software-properties-common python3-dev python3-pip python3-venv

RUN locale-gen en_US en_US.UTF-8 && \
    update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8

# Allow pip to install packages globally in container
ENV PIP_BREAK_SYSTEM_PACKAGES=1

########################################################
# 3. ROS 2 Jazzy Installation (Native Ubuntu 24.04)
########################################################
# Add ROS 2 GPG key and repository
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.asc | gpg --dearmor -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" \
    | tee /etc/apt/sources.list.d/ros2.list > /dev/null

# Install ROS 2 Base and Build Tools
RUN apt-get update && apt-get install -y \
    ros-jazzy-ros-base \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-vcstool \
    ros-dev-tools

RUN rosdep init && rosdep update

########################################################
# 4. Pinocchio & RobotPkg (Native Python 3.12 Path)
########################################################
RUN mkdir -p /etc/apt/keyrings && \
    curl -fsSL http://robotpkg.openrobots.org/packages/debian/robotpkg.asc -o /etc/apt/keyrings/robotpkg.asc && \
    echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/robotpkg.asc] http://robotpkg.openrobots.org/packages/debian/pub $(lsb_release -cs) robotpkg" \
    > /etc/apt/sources.list.d/robotpkg.list

# Installing Pinocchio for Python 3.12
RUN apt-get update && apt-get install -y \
    robotpkg-py312-pinocchio \
    robotpkg-py312-eigenpy \
 && rm -rf /var/lib/apt/lists/*

# Environment variables for Pinocchio (Directly mapping to /opt/openrobots)
ENV PATH="/opt/openrobots/bin:${PATH}" \
    LD_LIBRARY_PATH="/opt/openrobots/lib:${LD_LIBRARY_PATH}" \
    PYTHONPATH="/opt/openrobots/lib/python3.12/site-packages:${PYTHONPATH}"



########################################################
# 5. libfranka (robot_motion_interface)
########################################################
RUN apt-get update && apt-get install -y \
    libpoco-dev \
    libfmt-dev 

ENV CMAKE_POLICY_VERSION_MINIMUM=3.5
WORKDIR /tmp

RUN git clone --recurse-submodules https://github.com/frankarobotics/libfranka.git && \
    cd libfranka && \
    git checkout 0.9.2 && \
    git submodule update && \
    mkdir build && \
    cd build && \
    cmake -DCMAKE_BUILD_TYPE=Release \
          -DCMAKE_PREFIX_PATH=/opt/openrobots/lib/cmake \
          -DBUILD_TESTS=OFF .. && \
    make && \
    cpack -G DEB && \
    dpkg -i libfranka*.deb && \
    cd /tmp && rm -rf libfranka

########################################################
# 6. Workspace & Conda Setup
########################################################
WORKDIR /workspace

ENV CONDA_DIR=/root/miniconda3
RUN wget https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh  && \
    bash Miniconda3-latest-Linux-x86_64.sh -b  -p $CONDA_DIR && \
    $CONDA_DIR/bin/conda init bash  && \
    source $CONDA_DIR/etc/profile.d/conda.sh && \
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main && \
    conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r  && \
    conda remove -y conda-anaconda-tos anaconda-auth || true && \
    conda create -n policy python=3.12 -y && \
    conda activate policy && \
    pip install colcon-common-extensions && \
    pip install numpy==1.26 scipy ninja pyyaml matplotlib && \
    pip install torch==2.7.0 --index-url https://download.pytorch.org/whl/cu128

WORKDIR /workspace
COPY ./libs /workspace/libs
COPY ./app /workspace/app

WORKDIR /workspace/libs/robot_motion
RUN rm -rf build/ && \
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && \
    cmake --build build -j && \
    cmake --install build && \
    ldconfig

WORKDIR /workspace/libs/robot_motion_interface
RUN rm -rf build/ && \
    cmake -S . -B build -DCMAKE_BUILD_TYPE=Release  && \
    cmake --build build -j && \
    cmake --install build && \
    ldconfig

# policy node dependencies
RUN apt update && apt install -y \
    ros-jazzy-vision-msgs

# It takes too long to install torch each time
RUN source $CONDA_DIR/etc/profile.d/conda.sh && \
    conda activate policy && \
    pip install -e /workspace/libs/robot_motion && \
    pip install -e /workspace/libs/robot_motion_interface && \
    pip install -e /workspace/libs/sensor_interface/sensor_interface_py && \
    pip install numpy==1.26 pybind11 lark pyrealsense2 opencv-python>=4.8.0

# Realsense, opengl, opencv dependencies
RUN apt update && apt install -y \
    libusb-1.0-0 \
    libgl1 \
    libglx-mesa0 \
    libglib2.0-0 \
    libx11-6 \
    libxext6 \
    libxcb-cursor0 \
    libxcb-xinerama0 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-render-util0 \
    libxcb-xkb1 \
    libxkbcommon-x11-0

RUN apt update && apt install -y \
    iputils-ping \
    net-tools \
    iproute2 \
    tcpdump \
    nmap \
    netcat-openbsd \
    ufw

    ########################################################
# 7. Final Configuration
########################################################
RUN echo "export PATH=/opt/openrobots/bin:\$PATH" >> /root/.bashrc && \
    echo "export PKG_CONFIG_PATH=/opt/openrobots/lib/pkgconfig:\$PKG_CONFIG_PATH" >> /root/.bashrc && \
    echo "export LD_LIBRARY_PATH=/opt/openrobots/lib:\$LD_LIBRARY_PATH" >> /root/.bashrc && \
    echo "export PYTHONPATH=/opt/openrobots/lib/python3.12/site-packages:\$PYTHONPATH" >> /root/.bashrc && \
    echo "export CMAKE_PREFIX_PATH=/opt/openrobots:\$CMAKE_PREFIX_PATH" >> /root/.bashrc

RUN echo "source /root/miniconda3/etc/profile.d/conda.sh && conda activate policy" >> /root/.bashrc && \
    echo "source /opt/ros/jazzy/setup.bash" >> /root/.bashrc

ENV RMW_IMPLEMENTATION=rmw_fastrtps_cpp

WORKDIR /workspace
CMD ["bash"]